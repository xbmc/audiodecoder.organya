msgctxt "#30000"
msgid "Loop indefinitely"
msgstr "Neograničeno ponavljanje petlje"

msgctxt "#30001"
msgid "When enabled, plays either infinite or repeats with the following setting."
msgstr "Kada je omogućeno, reproducira se beskonačno ili se ponavlja sa sljedećim postavkama."

msgctxt "#30002"
msgid "Loop count"
msgstr "Broj petlji"

msgctxt "#30003"
msgid "The number of repetitions or as infinite."
msgstr "Broj ponavljanja ili kao beskonačan."

msgctxt "#30004"
msgid "Infinity"
msgstr "Beskonačnost"

msgctxt "#30005"
msgid "Fade time (ms)"
msgstr "Vrijeme postepenog smanjivanja (ms)"

msgctxt "#30006"
msgid "Time at the end to reduce the volume."
msgstr "Vrijeme je na kraju za smanjenje jačine zvuka."
