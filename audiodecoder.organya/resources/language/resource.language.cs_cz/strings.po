msgctxt "#30000"
msgid "Loop indefinitely"
msgstr "Opakovat donekonečna"

msgctxt "#30001"
msgid "When enabled, plays either infinite or repeats with the following setting."
msgstr "Je-li povoleno, přehrávání probíhá buď donekonečna, nebo se opakuje podle následujícího nastavení."

msgctxt "#30002"
msgid "Loop count"
msgstr "Počet opakování"

msgctxt "#30003"
msgid "The number of repetitions or as infinite."
msgstr "Počet opakování, případně nekonečno."

msgctxt "#30004"
msgid "Infinity"
msgstr "Nekonečno"

msgctxt "#30005"
msgid "Fade time (ms)"
msgstr "Doba zeslabení (ms)"

msgctxt "#30006"
msgid "Time at the end to reduce the volume."
msgstr "Doba na konci skladby pro snížení hlasitosti."
